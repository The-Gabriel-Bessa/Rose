{
  "name": "rose-opencode",
  "version": "1.0.0",
  "description": "Rose - Autonomous Developer / Tester / User Orchestrator",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "build:exe": "electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.rose.orchestrator",
    "productName": "Rose Orchestrator",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "electron/**/*",
      "assets/**/*"
    ]
  },
  "dependencies": {
    "@opencode-ai/sdk": "latest"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
